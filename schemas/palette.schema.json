{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildwright.local/schemas/palette.schema.json",
  "title": "BuildWright Palette",
  "type": "object",
  "required": [
    "id",
    "roles",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vanilla\\.palette\\."
    },
    "roles": {
      "type": "object",
      "minProperties": 2
    },
    "rules": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildwright.local/schemas/technique.schema.json",
  "title": "BuildWright Technique",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "steps",
    "anti_patterns",
    "qa"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vanilla\\.technique\\."
    },
    "steps": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
